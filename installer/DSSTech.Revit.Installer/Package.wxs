<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Stable UpgradeCode across versions. ProductCode regenerates each build (*). -->
  <Package
      Name="DSSTech Revit"
      Manufacturer="DSS Technology Co. Ltd"
      Version="$(var.ProductVersion)"
      UpgradeCode="B8E4F2A1-5C3D-4E9F-A7B1-2D6C8E0F4A91"
      Scope="perMachine"
      Language="1033">
    <SummaryInformation
        Description="DSSTech Revit add-in (hosts 2025–2027)"
        Manufacturer="DSS Technology Co. Ltd" />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of DSSTech Revit is already installed. Setup will now exit."
        Schedule="afterInstallInitialize" />

    <!-- Always lay every file down, whatever version is installed: the add-in DLL was 1.0.0.0 before it took its
         number from VERSION (0.1.2.0 now), and Windows Installer skips a file "older" than the one present and then
         the old product's removal deletes it (DSSTech.dll missing after the upgrade). -->
    <Property Id="REINSTALLMODE" Value="amus" />

    <!-- Brand icon in Programs and Features (scripts\generate-installer-icon.ps1 draws it). -->
    <Icon Id="DSSTech.ico" SourceFile="DSSTech.ico" />
    <Property Id="ARPPRODUCTICON" Value="DSSTech.ico" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Feature Id="ProductFeature" Title="DSSTech Revit" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AutodeskFolder" Name="Autodesk">
        <Directory Id="RevitFolder" Name="Revit">
          <Directory Id="AddinsFolder" Name="Addins" />
        </Directory>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
